server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name labcamp.duckdns.org;

  ssl_certificate /etc/letsencrypt/live/labcamp.duckdns.org/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/labcamp.duckdns.org/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;

  location / {
    proxy_pass http://labcamp_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
